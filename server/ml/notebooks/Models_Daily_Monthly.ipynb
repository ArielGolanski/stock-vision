    "            predictor.build_model(n_features=features.shape[1])\n",
    "\n",
    "            (x_train, y_train), (x_test, y_test), y_test_actual, training_len = predictor.prepare_data(features, target)\n",
    "\n",
    "            print(f\"Training data shape: {x_train.shape}\")\n",
    "            print(f\"Training model...\")\n",
    "\n",
    "            history = predictor.train(x_train, y_train, epochs=15, batch_size=32)\n",
