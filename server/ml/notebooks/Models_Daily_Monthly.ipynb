    "            predictions = predictor.predict(x_test)\n",
    "\n",
    "            # Evaluate model\n",
    "            metrics = evaluate_model(y_test_actual.flatten(), predictions, f\"{ticker} {target_column} Model\")\n",
    "\n",
    "            # Step 1 - Save metrics for Accuracy Page\n",
    "            metrics_path = os.path.join(model_dir, f\"{prefix}_metrics.json\") # Updated to use prefix\n",
    "            metrics_data = {\n",
