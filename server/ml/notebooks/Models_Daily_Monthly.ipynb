    "\n",
    "class EnhancedLSTMPredictor:\n",
    "    def __init__(self, sample_size=60, lstm_units=[128, 64], dropout_rate=0.2):\n",
    "        self.sample_size = sample_size\n",
    "        self.lstm_units = lstm_units\n",
    "        self.dropout_rate = dropout_rate\n",
    "        self.feature_scaler = MinMaxScaler(feature_range=(0, 1))\n",
    "        self.target_scaler = MinMaxScaler(feature_range=(0, 1))\n",
    "        self.model = None\n",
    "\n",
    "    def build_model(self, n_features):\n",
    "        \"\"\"Build enhanced LSTM model\"\"\"\n",
    "        self.model = Sequential([\n",
    "            LSTM(self.lstm_units[0], return_sequences=True,\n",
    "                 input_shape=(self.sample_size, n_features)),\n",
    "            Dropout(self.dropout_rate),\n",
    "            LSTM(self.lstm_units[1], return_sequences=False),\n",
    "            Dropout(self.dropout_rate),\n",
    "            Dense(50, activation='relu'),\n",
    "            Dropout(self.dropout_rate),\n",
    "            Dense(25, activation='relu'),\n",
    "            Dense(1, activation='linear')\n",
    "        ])\n",
    "\n",
    "        self.model.compile(optimizer='adam', loss='mean_squared_error', metrics=['mae'])\n",
    "        return self.model\n",
    "\n",
    "    def prepare_data(self, features, target):\n",
    "        \"\"\"Prepare training and testing datasets\"\"\"\n",
    "        # Scale features and target separately\n",
    "        scaled_features = self.feature_scaler.fit_transform(features)\n",
    "        scaled_target = self.target_scaler.fit_transform(target)\n",
    "\n",
    "        # Split data\n",
    "        training_len = int(np.ceil(len(scaled_features) * 0.8))\n",
    "\n",
    "        # Create sequences\n",
    "        x_train, y_train = self._create_sequences(\n",
    "            scaled_features[:training_len],\n",
    "            scaled_target[:training_len]\n",
    "        )\n",
    "\n",
    "        x_test, y_test = self._create_sequences(\n",
    "            scaled_features[training_len-self.sample_size:],\n",
    "            scaled_target[training_len-self.sample_size:]\n",
    "        )\n",
    "\n",
    "        # Adjust y_test to match the correct indices\n",
    "        y_test_actual = target[training_len:]\n",
    "\n",
    "        return (x_train, y_train), (x_test, y_test), y_test_actual, training_len\n",
    "\n",
    "    def _create_sequences(self, features, target):\n",
    "        \"\"\"Create sequences for LSTM training\"\"\"\n",
    "        x, y = [], []\n",
    "        for i in range(self.sample_size, len(features)):\n",
    "            x.append(features[i-self.sample_size:i])\n",
    "            y.append(target[i, 0])\n",
    "        return np.array(x), np.array(y)\n",
    "\n",
    "    def train(self, x_train, y_train, epochs=20, batch_size=32, validation_split=0.1):\n",
    "        \"\"\"Train the model\"\"\"\n",
    "        history = self.model.fit(\n",
    "            x_train, y_train,\n",
    "            batch_size=batch_size,\n",
    "            epochs=epochs,\n",
    "            validation_split=validation_split,\n",
    "            verbose=1\n",
    "        )\n",
    "        return history\n",
    "\n",
    "    def predict(self, x_test):\n",
    "        \"\"\"Make predictions\"\"\"\n",
    "        pred_scaled = self.model.predict(x_test, verbose=0)\n",
    "\n",
    "        # Create dummy array for inverse transform\n",
    "        dummy_array = np.zeros((len(pred_scaled), 1))\n",
    "        dummy_array[:, 0] = pred_scaled[:, 0]\n",
    "\n",
    "        predictions = self.target_scaler.inverse_transform(dummy_array)[:, 0]\n",
    "        return predictions\n",
    "\n",
    "    def forecast_future(self, df, features, target_column, n_days=5):\n",
    "        \"\"\"Forecast future values\"\"\"\n",
    "        # Get the last sequence\n",
    "        last_features = self.feature_scaler.transform(features[-self.sample_size:])\n",
    "        last_sequence = last_features.reshape(1, self.sample_size, -1)\n",
    "\n",
    "        future_predictions = []\n",
    "        current_price = df['Close'].iloc[-1]\n",
    "        future_prices = []\n",
    "\n",
    "        for i in range(n_days):\n",
    "            # Predict next change %\n",
    "            next_pred_scaled = self.model.predict(last_sequence, verbose=0)\n",
    "\n",
    "            # Inverse transform to get actual % change\n",
    "            dummy = np.zeros((1, 1))\n",
    "            dummy[0, 0] = next_pred_scaled[0, 0]\n",
    "            next_change = self.target_scaler.inverse_transform(dummy)[0, 0]\n",
    "\n",
    "            future_predictions.append(float(next_change))\n",
    "\n",
    "            # Calculate future price based on change %\n",
    "            if target_column == 'Daily Change %':\n",
    "                current_price = current_price * (1 + next_change/100.0)\n",
    "            elif target_column == 'Monthly Change %':\n",
    "                # For monthly, we assume the change is spread over ~21 days\n",
    "                daily_change = next_change / 21.0\n",
    "                current_price = current_price * (1 + daily_change/100.0)\n",
    "\n",
    "            future_prices.append(float(current_price))\n",
    "\n",
    "            # Update sequence for next prediction\n",
    "            # This is simplified - in reality, you'd need to update all features\n",
    "            last_sequence = np.roll(last_sequence, -1, axis=1)\n",
    "            last_sequence[0, -1, 0] = next_pred_scaled[0, 0]  # Update only the first feature\n",
    "\n",
    "        return future_predictions, future_prices\n",
    "\n",
    "    def save(self, model_path=\"model\", prefix=\"daily\"):\n",
    "        \"\"\"Save model + scalers\"\"\"\n",
    "        # Save keras model\n",
    "        self.model.save(f\"{model_path}_{prefix}.keras\")\n",
    "\n",
    "        # Save scalers\n",
    "        joblib.dump(self.feature_scaler, f\"{model_path}_{prefix}_feature_scaler.pkl\")\n",
    "        joblib.dump(self.target_scaler, f\"{model_path}_{prefix}_target_scaler.pkl\")\n",
    "        print(f\"Model and scalers saved as {model_path}_{prefix}.*\")\n",
    "\n",
    "    def load(self, model_path=\"model\", prefix=\"daily\"):\n",
    "        \"\"\"Load model + scalers\"\"\"\n",
    "        self.model = tf.keras.models.load_model(f\"{model_path}_{prefix}.keras\")\n",
    "        self.feature_scaler = joblib.load(f\"{model_path}_{prefix}_feature_scaler.pkl\")\n",
    "        self.target_scaler = joblib.load(f\"{model_path}_{prefix}_target_scaler.pkl\")\n",
    "        print(f\"Model and scalers loaded from {model_path}_{prefix}.*\")\n",
    "\n",
    "def evaluate_model(true_values, predictions, model_name):\n",
    "    \"\"\"Evaluate model performance\"\"\"\n",
    "    mse = np.mean((true_values - predictions) ** 2)\n",
    "    rmse = np.sqrt(mse)\n",
    "    mae = np.mean(np.abs(true_values - predictions))\n",
    "\n",
    "    # Calculate MAPE, avoiding division by zero\n",
    "    mask = true_values != 0\n",
    "    if np.sum(mask) > 0:\n",
    "        mape = np.mean(np.abs((true_values[mask] - predictions[mask]) / true_values[mask])) * 100\n",
    "    else:\n",
    "        mape = np.nan  # Handle case with all-zero true values\n",
    "\n",
    "    print(f\"\\n{model_name} Performance Metrics:\")\n",
    "    print(f\"MSE: {mse:.4f}\")\n",
    "    print(f\"RMSE: {rmse:.4f}\")\n",
    "    print(f\"MAE: {mae:.4f}\")\n",
    "    print(f\"MAPE: {mape:.4f} %\") # Added MAPE print\n",
    "\n",
    "    return {'MSE': mse, 'RMSE': rmse, 'MAE': mae, 'MAPE': mape} # Added MAPE to return\n",
    "\n",
